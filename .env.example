# 复制为 .env 后修改。ADMIN_PIN 必填，首次启动会写入数据库并哈希保存。
PORT=8080
HOST=0.0.0.0

# 后台管理 PIN（必填）。前台展示无需登录，只有后台需要 PIN
ADMIN_PIN=改成另一个六位数字

# 线上 HTTPS 环境保持 true
COOKIE_SECURE=true
# 仅在前面有 Nginx 等反向代理且会覆盖 X-Forwarded-For 时开启；
# 直接暴露端口时请设为 false，否则客户端可伪造 IP 绕过黑名单与登录锁定
TRUST_PROXY=true
# 仅在流量确定经过 Cloudflare 时开启，否则 CF-Connecting-IP 可被伪造
# TRUST_CF_HEADER=true

CODE_TTL_SECONDS=600
OFFLINE_ALERT_MINUTES=15

# 海外 IP 拦截的初始默认值；启动后可在后台「IP 规则」页一键开关，开关状态以数据库为准
# 误拦时可在后台「IP 规则」把该 IP/网段设为「始终放行」来豁免
BLOCK_OVERSEAS=true

# 可选告警：飞书群机器人 / Bark / 自建 webhook
# ALERT_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxx

# 可选：后台白名单，支持单 IP 与网段
# ADMIN_ALLOW_IPS=1.2.3.4,10.0.0.0/8

# SQLite 数据目录
DATA_DIR=data
