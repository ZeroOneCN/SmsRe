# Nginx 反向代理示例（香港/海外 VPS + 域名 + Let's Encrypt）
# 放到 /etc/nginx/conf.d/smsfor.conf，替换 sms.example.com 与证书路径。

server {
    listen 80;
    server_name sms.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name sms.example.com;

    ssl_certificate     /etc/letsencrypt/live/sms.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/sms.example.com/privkey.pem;

    # 只允许正常大小的 webhook 请求
    client_max_body_size 64k;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;

        # 关键：覆盖而不是追加 XFF，防止客户端伪造 IP 绕过黑名单
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Host $host;

        # SSE 必须关闭缓冲，否则验证码不会实时出现
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;

        add_header X-Robots-Tag "noindex, nofollow" always;
    }
}
